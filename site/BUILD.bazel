"""
Static public landing under Bazel (S3 bazel_full lane; SvelteKit 3.0.1 and
TypeScript 7.0.2 since the RU1 uplift, 2026-10-10).

`pnpm run check` / `pnpm run build` in site/ (and `just site-check` /
`just site-build`) stay the accepted gates. These targets build the same
sources from site/pnpm-lock.yaml through rules_js:

    //site:sveltekit_types           svelte-kit sync  -> .svelte-kit/, node_modules/$app/
    //site:svelte_check_test         svelte-check --tsgo (pnpm run check)
    //site:svelte_check_canary_test  the same gate with seeded errors (must report both)
    //site:build                     vite build (pnpm run build) -> build/

Bazel writes nothing into site/: every output is under bazel-bin.

The two in-house packages (@xoxd/theme, @xoxd/public-chrome) are Bazel-only
(ruling RU9): each is a bazel_dep in MODULE.bazel, linked here from the
module's `:pkg` target with npm_link_package, and absent from package.json and
pnpm-lock.yaml. `just site-install` materialises the same outputs into
site/node_modules for the plain pnpm loop (scripts/inhouse-link.mjs).

The prerender of the agents page reads the repository tool registry from
`<site>/../program/tools.json`; //bazel:site_build.mjs lays that file out
beside the copied site.
"""
load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@npm_site//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".npmrc",
    ".pnpmfile.cjs",
    "package.json",
    "pnpm-lock.yaml",
    "patches/sveltejs__kit-3.0.1.patch",
    "patches/svelte-check-4.7.6.patch",
    "pnpm-workspace.yaml",
])

npm_link_all_packages(name = "node_modules")

# Exactly the dependencies and devDependencies of site/package.json.
SITE_NPM_PACKAGES = [
    ":node_modules/@axe-core/playwright",
    ":node_modules/@playwright/test",
    ":node_modules/@fontsource/inter",
    ":node_modules/@lucide/svelte",
    ":node_modules/@skeletonlabs/skeleton",
    ":node_modules/@skeletonlabs/skeleton-svelte",
    ":node_modules/@sveltejs/adapter-static",
    ":node_modules/@sveltejs/kit",
    ":node_modules/@sveltejs/vite-plugin-svelte",
    ":node_modules/@tailwindcss/vite",
    ":node_modules/@types/node",
    ":node_modules/@typescript/typescript6",
    ":node_modules/svelte",
    ":node_modules/svelte-check",
    ":node_modules/tailwindcss",
    ":node_modules/typescript",
    ":node_modules/vite",
]

# In-house packages (ruling RU9): one npm_link_package per bazel_dep, linked
# from the registry module's own `:pkg` target. Peers (svelte, Skeleton,
# lucide) resolve from this package's node_modules.
npm_link_package(
    name = "node_modules/@xoxd/public-chrome",
    src = "@xoxd_public_chrome//:pkg",
)

npm_link_package(
    name = "node_modules/@xoxd/theme",
    src = "@xoxd_theme//:pkg",
)

SITE_INHOUSE_PACKAGES = [
    ":node_modules/@xoxd/public-chrome",
    ":node_modules/@xoxd/theme",
]

filegroup(
    name = "site_srcs",
    srcs = glob(
        [
            "scripts/**",
            "src/**",
            "static/**",
        ],
        allow_empty = True,
    ) + [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "vite.config.ts",
    ],
)

# One runner for sync, check and build, copied next to node_modules so Node
# resolves @sveltejs/kit, svelte-check and vite from this package's link tree.
copy_file(
    name = "site_build_runner",
    src = "//bazel:site_build.mjs",
    out = "bazel_site_build.mjs",
)

js_binary(
    name = "site_build_bin",
    data = SITE_NPM_PACKAGES + SITE_INHOUSE_PACKAGES,
    entry_point = "bazel_site_build.mjs",
)

# SvelteKit 3 writes the parent tsconfig (`$app/tsconfig`) and the `$app` types
# under node_modules/$app, and the route types under .svelte-kit; both trees
# are declared outputs so every consumer sees the same generated types.
js_run_binary(
    name = "sveltekit_types",
    srcs = [":site_srcs"],
    args = ["sync"],
    chdir = package_name(),
    out_dirs = [
        ".svelte-kit",
        "node_modules/$app",
    ],
    tool = ":site_build_bin",
)

# Sources and their generated tsconfig in one declared tree. The runner copies
# it to scratch before checking or building so nothing follows a symlink out
# of the action.
copy_to_directory(
    name = "site_workspace",
    srcs = [
        ":site_srcs",
        ":sveltekit_types",
    ],
    hardlink = "off",
    root_paths = ["."],
)

# RU13: svelte-check runs in its TypeScript 7 native mode (`--tsgo`), which
# writes transpiled components into .svelte-kit (read-only in runfiles), so the
# runner checks a writable scratch copy of :site_workspace.
js_test(
    name = "svelte_check_test",
    timeout = "long",
    args = [
        "check",
        "--workspace",
        "$(rootpath :site_workspace)",
    ],
    data = [":site_workspace"] + SITE_NPM_PACKAGES + SITE_INHOUSE_PACKAGES,
    entry_point = "bazel_site_build.mjs",
)

# Seeded-error canary for the gate above: one .ts and one .svelte type error
# must both be reported, so a tsconfig that checks nothing cannot pass green.
js_test(
    name = "svelte_check_canary_test",
    timeout = "long",
    args = [
        "check",
        "--workspace",
        "$(rootpath :site_workspace)",
        "--canary",
    ],
    data = [":site_workspace"] + SITE_NPM_PACKAGES + SITE_INHOUSE_PACKAGES,
    entry_point = "bazel_site_build.mjs",
)

# The tool registry the agents page reads at prerender time, copied into this
# package (rules_js copies only same-package files to the output tree).
copy_file(
    name = "tool_registry",
    src = "//:program/tools.json",
    out = "bazel_tool_registry.json",
)

js_run_binary(
    name = "build",
    srcs = [
        ":site_workspace",
        ":tool_registry",
    ],
    args = [
        "build",
        "--workspace",
        "site_workspace",
        "--registry",
        "bazel_tool_registry.json",
        "--output-dir",
        "build",
    ],
    chdir = package_name(),
    out_dirs = ["build"],
    patch_node_fs = False,
    tool = ":site_build_bin",
)
