load("@aspect_rules_js//js:defs.bzl", "js_test")

[js_test(
    name = name,
    data = [
        "lib.mjs",
        "//:test_inputs",
    ],
    entry_point = entry,
) for name, entry in [
    ("palette_test", "palette.test.mjs"),
    ("theme_css_test", "theme_css.test.mjs"),
    ("fouc_test", "fouc.test.mjs"),
]]

js_test(
    name = "dist_scan_test",
    args = ["$(rootpath //:pkg)"],
    data = [
        "lib.mjs",
        "//:pkg",
    ],
    entry_point = "dist_scan.test.mjs",
)
