{
  "name": "video-utils-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Static public landing for video-utils. Prerendered, no server, no analytics, no forms.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.17 <23"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "leak-scan": "node scripts/leak-scan.mjs build",
    "verify:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@lucide/svelte": "1.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@typescript/typescript6": "6.0.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
