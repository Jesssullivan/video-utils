{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "video-utils-artifacts",
    "namespace": "video-utils",
    "labels": {
      "app.kubernetes.io/name": "video-utils-web",
      "app.kubernetes.io/part-of": "video-utils",
      "app.kubernetes.io/component": "web-bff"
    },
    "annotations": {
      "video-utils.dev/contract": "docs/spec/sprints/AUTH_HOSTING_S3.md",
      "video-utils.dev/applied": "false",
      "video-utils.dev/storage-class": "unknown; storageClassName omitted so the cluster default applies, operator decides at apply"
    }
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "resources": {
      "requests": {
        "storage": "20Gi"
      }
    }
  }
}
