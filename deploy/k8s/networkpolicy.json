{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "video-utils-default-deny-ingress",
        "namespace": "video-utils",
        "labels": {
          "app.kubernetes.io/name": "video-utils-web",
          "app.kubernetes.io/part-of": "video-utils",
          "app.kubernetes.io/component": "web-bff"
        },
        "annotations": {
          "video-utils.dev/contract": "docs/spec/sprints/AUTH_HOSTING_S3.md",
          "video-utils.dev/applied": "false"
        }
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "video-utils-allow-cloudflared",
        "namespace": "video-utils",
        "labels": {
          "app.kubernetes.io/name": "video-utils-web",
          "app.kubernetes.io/part-of": "video-utils",
          "app.kubernetes.io/component": "web-bff"
        },
        "annotations": {
          "video-utils.dev/contract": "docs/spec/sprints/AUTH_HOSTING_S3.md",
          "video-utils.dev/applied": "false",
          "video-utils.dev/cloudflared-namespace": "unknown; the placeholder label value matches no namespace (fail closed) until the operator sets the cloudflared connector namespace at apply"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "video-utils-web"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "unset-cloudflared-namespace"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 3000
              }
            ]
          }
        ]
      }
    }
  ]
}
