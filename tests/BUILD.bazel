# Modules that read the checkout's web/ tree. //web is deliberately not a data
# dependency of the Python tests: loading it requires the npm lock translation.
WEB_TREE_TESTS = [
    "test_auth_hosting_s3",
    "test_auth_token_s3",
    "test_bazel_graph_s3",
    "test_web_house_stack_s3",
    "test_web_parity",
    "test_web_processing_s3",
    "test_web_reliability",
    "test_web_runs_s3",
    "test_web_stack",
]

unittest_py_tests(
    srcs = glob(["test_*.py"]),
    data = [
        ":all_files",
        "//:repo_data",
        "//bazel:all_files",
        "//native/au-spike:all_files",
        "//scripts:all_files",
        "//src:all_files",
        "//tools/bazel:all_files",
    ],
    exclusive = EXCLUSIVE_TESTS,
    ffmpeg = FFMPEG_TESTS,
    host_tools = HOST_TOOL_TESTS,
    web_tree = WEB_TREE_TESTS,
    workspace_artifacts = WORKSPACE_ARTIFACT_TESTS,
    deps = ["//scripts:workers"],
)

test_suite(
    name = "python",
    tags = ["python-unittest"],
)

# The stdlib-only subset: no FFmpeg, no host tools.
test_suite(
    name = "python_stdlib",
    tags = [
        "-requires-ffmpeg",
        "-requires-host-tools",
        "python-unittest",
    ],
)

# tests/cli.rs runs the built CLI: Cargo exposes it as CARGO_BIN_EXE_video-utils.
rust_test(
    name = "rust_cli_test",
    srcs = ["cli.rs"],
    crate_root = "cli.rs",
    data = ["//src:video-utils"],
    edition = RUST_EDITION,
    rustc_env = {"CARGO_BIN_EXE_video-utils": "$(rootpath //src:video-utils)"},
    deps = ["//src:video_utils"],
)

# tests/dsp.rs: the FFmpeg parity case is #[ignore] and reads FFMPEG itself.
rust_test(
    name = "rust_dsp_test",
    srcs = ["dsp.rs"],
    crate_root = "dsp.rs",
    edition = RUST_EDITION,
    deps = ["//src:video_utils"],
)
