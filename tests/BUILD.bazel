    "test_arrangement_markers",
    "test_eq_shelf",
    "test_fuller_profile",
    "test_marked_compact",
    "test_marked_video",
    "test_mcp",
    "test_media",
    "test_phone_fixtures",
    "test_review_ui_s2",
    "test_share_export",
    "test_share_export_preroll",
    "test_stems_estimate",
    "test_take_intake",
    "test_timing_calibration",
    "test_tone_ab",
    "test_tool_contracts",
    "test_web_jobs",
    "test_web_parity",
    "test_web_processing_s3",
    "test_web_reliability",
    "test_web_runs_s3",
]

# Modules that use node, pnpm, git or the hash-pinned Nix FFmpeg path. Bazel
# gives tests a minimal PATH; add --config=host-tools to pass PATH and HOME.
HOST_TOOL_TESTS = [
    "test_auth_hosting_s3",
    "test_auth_token_s3",
    "test_eq_shelf",
    "test_phone_fixtures",
    "test_phrase_riff_s2",
    "test_public_site_s3",
    "test_review_ui_s1",
    "test_review_ui_s2",
    "test_s3_tool_admission",
    "test_share_export",
    "test_share_export_preroll",
    "test_sprint1_audit",
    "test_take_intake",
    "test_web_parity",
    "test_web_processing_s3",
    "test_web_reliability",
    "test_web_runs_s3",
    "test_web_stack",
]

# Modules that install into, build or serve from the checkout's web/ tree.
# They must not run beside each other or any other test.
EXCLUSIVE_TESTS = [
    "test_auth_hosting_s3",
    "test_public_site_s3",
    "test_web_parity",
    "test_web_processing_s3",
    "test_web_reliability",
    "test_web_runs_s3",
    "test_web_stack",
]

# Modules that read or create paths under the checkout's artifacts/ tree, which
# is private, ignored by Git and by Bazel, and therefore not a declared input.
WORKSPACE_ARTIFACT_TESTS = [
    "test_annotation_markers",
    "test_apply_capture_profile",
    "test_arrangement_reference_tool",
    "test_auth_token_s3",
    "test_capture_application_tool",
    "test_click_attack_ab",
    "test_corpus_eval_s2",
    "test_demo",
    "test_eq_shelf",
    "test_flags_triage",
    "test_marked_compact",
    "test_phone_fixtures",
    "test_phrase_anchor",
    "test_phrase_localize",
    "test_phrase_localize_audit",
    "test_phrase_timing",
    "test_public_site_s3",
    "test_review_ui_s2",
    "test_rhythm",
    "test_s2_tool_admission",
    "test_s3_tool_admission",
    "test_share_export",
    "test_share_export_preroll",
    "test_take_intake",
    "test_timing_calibration",
    "test_tool_contracts",
