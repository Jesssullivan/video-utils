 "parallel": {
  "max_stages": 2,
  "bound": "narrate/bounded.sh"
 },
 "row": {
  "name": "client-video-narrated-render",
  "ruling": "TIN-7125 3672cb05: one general row with one pinned graph for client, internal and hardware jobs",
  "mapping": "graph.row_tasks: one stage is one task, parents are the stage depends_on, each root stage takes the gate as a parent and every render task lists the guard as a direct parent. A consumer pins this file by commit and blob and compares tasks_sha256 with its own task list (graph.row_tasks_sha256).",
  "guard": {
   "name": "bs21_privacy_guard",
   "parents": [
    "admit"
   ],
   "optional": false,
   "effect": "none"
  },
  "effect_none": [
   "admit",
   "voice_qa",
   "avatar_check",
   "deliver_check"
  ],
  "operator_tasks": [
   {
    "name": "quiet_window_check",
    "parents": [
     "deliver_check"
    ],
    "optional": false,
    "effect": "none"
   },
   {
    "name": "outbox_post",
    "parents": [
     "deliver_check",
     "handoff",
     "quiet_window_check"
    ],
    "optional": false,
    "effect": "none"
   }
  ],
  "tasks_sha256": "c0be61edb1d38a42d49a37789f4e5c65c3f6fa9c370f7ff8342f872fbf1dc21b"
 },
 "execution_policy": "narrate/video/graph.py holds the same table, a test keeps them equal, and narrate/dhall/check.py holds selected_by and edition_point to the Dhall job and Edition types. plan keys every stage from its knobs, source digests and upstream manifests and never runs one; tool names are proposals until root admits them (program/tools.json). Stages land in lanes L4 to L6. avatar_overlay and avatar_verify are neutral: dispatch.by names the job field (avatar.external) that picks the implementation, kitpip by default, the vrm draft or a Campaign job's look, so the stage tool names stay the same when a job moves from one to the other. An order edge carries no input: handoff waits on deliver_check and its key stays the same."
}
