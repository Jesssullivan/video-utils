    {
     "stage": "base",
     "how": "all"
    },
    {
     "stage": "place",
     "how": "all"
    },
    {
     "stage": "mix",
     "how": "all"
    },
    {
     "stage": "avatar",
     "how": "all"
    },
    {
     "stage": "avatar_check",
     "how": "all"
