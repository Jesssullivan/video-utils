  {
   "name": "text and tspans in order",
   "kind": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><text>Build <tspan>time</tspan> runs</text></svg>",
   "texts": [
    "Build",
    "time",
    "runs"
   ],
   "opaque": false
  },
  {
   "name": "a name split across two tspans reads as two strings",
   "kind": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><text><tspan>Quill</tspan><tspan>feather</tspan></text></svg>",
   "texts": [
    "Quill",
    "feather"
   ],
   "opaque": false
  },
  {
   "name": "a comment counts, as a plotting library writes a label",
   "kind": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><!-- Axis one --><path d=\"M0 0h1\"/></svg>",
   "texts": [
    "Axis one"
   ],
   "opaque": false
  },
  {
   "name": "aria-label then xlink:title, after the element's first text",
   "kind": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g xlink:title=\"Title\" aria-label=\"Aria\">first<text>second</text>tail</g></svg>",
   "texts": [
    "first",
    "Aria",
    "Title",
    "second",
    "tail"
   ],
   "opaque": false
  },
  {
   "name": "metadata, style and script are not read, a tail is",
   "kind": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><metadata>Hidden meta</metadata>after meta<style>.a{fill:red}</style><text>shown</text></svg>",
   "texts": [
    "after meta",
    "shown"
   ],
   "opaque": false
  },
  {
   "name": "character references and predefined entities",
   "kind": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><text>&#81;uill &#x66;eather &amp; &lt;co&gt; &quot;a&apos;</text></svg>",
   "texts": [
    "Quill feather & <co> \"a'"
   ],
   "opaque": false
  },
  {
   "name": "CDATA joins its run",
   "kind": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><text>one <![CDATA[two & three]]> four</text></svg>",
   "texts": [
    "one two & three four"
   ],
   "opaque": false
  },
  {
   "name": "a comment ends a text run",
   "kind": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><text>one<!-- two -->three</text></svg>",
   "texts": [
    "one",
    "two",
    "three"
   ],
   "opaque": false
  },
  {
   "name": "a processing instruction ends no text run",
   "kind": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><text>one<?note x?>two</text></svg>",
   "texts": [
    "onetwo"
   ],
   "opaque": false
  },
  {
   "name": "a comment outside the root is not read",
   "kind": "svg",
   "source": "<!-- outside --><svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><text>inside</text></svg><!-- after -->",
   "texts": [
    "inside"
   ],
   "opaque": false
  },
  {
