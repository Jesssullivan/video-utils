+    // narrate: no CORS. A request that carries an Origin header comes from a
+    // browser page, which may never list, register, replace or speak in a
+    // cloned voice ; it is refused before routing, and so is a Host header
+    // that does not name the loopback interface (DNS rebinding). Clients are
+    // local processes on the loopback interface only.
+    svr.set_pre_routing_handler([](const httplib::Request & req, httplib::Response & res) {
+        const std::string host = req.get_header_value("Host");
+        const bool loopback = host.rfind("127.0.0.1", 0) == 0 || host.rfind("localhost", 0) == 0 ||
+                              host.rfind("[::1]", 0) == 0;
+        if (req.has_header("Origin") || !loopback) {
+            tts_json_error(res, 403, "permission_error", "only loopback clients without a browser origin");
+            return httplib::Server::HandlerResponse::Handled;
+        }
+        return httplib::Server::HandlerResponse::Unhandled;
