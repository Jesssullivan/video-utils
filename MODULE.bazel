"""
video-utils - Bazel module (S3 bazel_graph lane).

Full graph for the Rust crates, the stdlib Python workers and their unittest
modules, and the SvelteKit web app. `just` is the operator entrypoint
(just/bazel.just); Nix is the dev environment. Cargo, `python3 -m unittest` and
pnpm stay the accepted gates; this graph does not replace them.

Version sites: rust-toolchain.toml / Cargo.toml (Rust), pyproject.toml (Python
floor), web/package.json + web/pnpm-lock.yaml (every npm package). The literals
below must equal those files; tests/test_bazel_graph_s3.py holds them together.

No Tinyland registry module is consumed: see tools/bazel/registry_modules.json
for the per-module decisions and evidence. First-party packages are only ever
consumed as `bazel_dep` + `npm_link_package`, never as npm specifiers.
"""

module(
    name = "video_utils",
    version = "0.1.0",
    compatibility_level = 1,
)

# Core (estate version).
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# Rust. 0.70.0 is the rules_rust release whose default toolchain is Rust 1.95.0,
# the channel pinned in rust-toolchain.toml. Neither crate has an external
# dependency, so there is no crate universe.
bazel_dep(name = "rules_rust", version = "0.70.0")

# Python (estate version, tinyland.dev). Workers are stdlib-first: no pip hub.
bazel_dep(name = "rules_python", version = "1.8.3")

# JavaScript / TypeScript. rules_nodejs is the estate version. rules_js and
# rules_ts are newer than the estate's 2.9.1 / 3.8.4 because web/ uses pnpm 11:
# rules_js reads pnpm 11's `allowBuilds` setting only from 3.1, and rules_ts
# 3.10.1 carries TypeScript 6.0.3 in its own version map.
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")

# Rust 1.95.0, edition 2024 (rust-toolchain.toml, Cargo.toml).
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Hermetic CPython 3.12 (pyproject.toml requires-python >=3.12).
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Node 22.13.1 (estate toolchain; inside web/package.json engines >=22.12 <23).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.13.1")

# pnpm 11.25.0 (web/package.json packageManager).
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "11.25.0",
)
use_repo(pnpm, "pnpm")

# npm packages come only from web/pnpm-lock.yaml. There is no second npm version
# site in Bazel, so Skeleton 5.0.1 and Effect 4.0.1 cannot drift from package.json.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//web:package.json",
        "//web:pnpm-workspace.yaml",
    ],
    npmrc = "//web:.npmrc",
    pnpm_lock = "//web:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)

# Keep every npm package byte-complete, as `pnpm install` does. The rules_js 3
# default ("basic" preset) drops README-like files, and SvelteKit reads its own
# src/types/synthetic/*.md at `svelte-kit sync` time.
npm.npm_exclude_package_contents(
    package = "*",
    presets = [],
)
use_repo(npm, "npm")

# The static site (site/) is its own pnpm workspace with its own lock: a second
# translation, so site/package.json + site/pnpm-lock.yaml stay the only npm
# version sites for the site (docs/spec/sprints/BAZEL_FULL_S3.md section 9).
#
# Site gate (recorded deviation, BAZEL_FULL_S3 section 9.2): rules_js refuses a
# lock whose pnpm-workspace.yaml has no `allowBuilds`, and one refused
# translation fails the whole npm extension (//web included). site/ lacks that
# root-owned line, so this usage is a dev dependency and .bazelrc drops it with
# `--ignore_dev_dependency` and deletes //site until root applies the requested
# lines (bazel_full-root-requests.json); then the two .bazelrc gate lines go.
npm_site = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "npm",
    dev_dependency = True,
)
npm_site.npm_translate_lock(
    name = "npm_site",
    data = [
        "//site:package.json",
        "//site:pnpm-workspace.yaml",
    ],
    npmrc = "//site:.npmrc",
    pnpm_lock = "//site:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
# The byte-complete `npm_exclude_package_contents` setting above is global to
# the npm extension (rules_js fails on a duplicate "*" tag), so it covers this
# lock too.
use_repo(npm_site, "npm_site")

# TypeScript 6.0.3 (web/package.json; integrity equals web/pnpm-lock.yaml).
typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(
    integrity = "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
    version = "6.0.3",
)
use_repo(typescript, "npm_typescript")
