# video-utils web BFF image (adapter-node), AUTH_HOSTING_S3.md section 5.1.
#
# Reviewed source only. Building, pushing or running this image is an operator act; this lane
# neither built nor pushed it (container_built: false). Build context: the web/ directory, e.g.
#   podman build -f Containerfile -t video-utils-web:<tag> .
# then pin the pushed image by digest in deploy/k8s/deployment.json (see deploy/README.md).
#
# Base: node 22.23.2 on Debian bookworm-slim, pinned by the multi-arch index digest observed from
# registry-1.docker.io for tag 22.23.2-bookworm-slim on 2026-10-07 (receipt:
# docs/agent-notes/sprints/20261007-s3/auth_hosting-implementation-receipt.json). The tag is
# informational; the digest is what is pulled.
#
# Never baked in: fixtures/, artifacts/, recordings or rendered media, models, .env* files,
# credentials. Every COPY below names its source explicitly; there is no "COPY . .".

FROM docker.io/library/node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS build
WORKDIR /src
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY svelte.config.js vite.config.ts tsconfig.json ./
COPY src/ ./src/
COPY static/ ./static/
RUN pnpm run build

FROM docker.io/library/node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS deps
WORKDIR /src
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile --prod

FROM docker.io/library/node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS runtime
WORKDIR /app
ENV NODE_ENV=production
# Hosted mode: serve.js refuses to start (exit 2) unless the complete tailnet configuration
# (Access team domain, AUDs, operator allowlist, public hosts, ORIGIN) arrives via the ConfigMap.
ENV VIDEO_UTILS_AUTH_MODE=tailnet HOST=0.0.0.0 PORT=3000
COPY --from=build --chown=0:0 /src/build ./build
COPY --from=deps --chown=0:0 /src/node_modules ./node_modules
COPY --chown=0:0 package.json serve.js ./
# serve.js validates the tailnet configuration at startup with these pure modules.
COPY --chown=0:0 src/lib/server/auth/ ./src/lib/server/auth/
USER 10001:10001
EXPOSE 3000
CMD ["node", "serve.js"]
