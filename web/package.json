{
  "name": "video-utils-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local loopback SvelteKit BFF fixture for video-utils (S2 prototype). Not a hosted deployment.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node serve.js",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y"
  },
  "dependencies": {
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
